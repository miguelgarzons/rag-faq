# Copia este archivo a .env y ajusta valores

# Requerido solo si usas Vertex AI real
GCP_PROJECT_ID=tu-proyecto-gcp

# Opcionales
GCP_MODEL_NAME=gemini-1.5-flash
GCP_LOCATION=us-central1
GCP_TIMEOUT_SECONDS=20

# true = intenta Vertex AI
# false = fallback local sin llamadas a Vertex
ENABLE_VERTEX_AI=false

# Ajustes RAG (calidad de respuesta)
# Perfil rapido: strict | balanced | recall
RAG_PROFILE=balanced
# Cantidad de fragmentos a recuperar por pregunta
RAG_TOP_K=3
# Multiplicador de candidatos iniciales para reranking hibrido
RAG_CANDIDATE_MULTIPLIER=4
# Peso del matching por palabras clave (0.0 a 1.0)
RAG_KEYWORD_WEIGHT=0.35
# Umbral maximo de distancia coseno (menor = mas estricto)
RAG_SCORE_THRESHOLD=0.45
# Fallback progresivo del threshold si no hay candidatos
RAG_THRESHOLD_FALLBACK_STEPS=0.10,0.20,0.35
# Limite superior para fallback del threshold
RAG_MAX_SCORE_THRESHOLD=0.95
